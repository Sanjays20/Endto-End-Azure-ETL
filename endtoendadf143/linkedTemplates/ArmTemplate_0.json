		{
			"name": "[concat(parameters('factoryName'), '/PL4_Files')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lkup_L4",
						"type": "Lookup",
						"dependsOn": [],
