									"directory": {
										"value": "@activity('Lkup_Job_Details').output.firstRow.sourcedirectory",
										"type": "Expression"
									},
									"filename": {
										"value": "@activity('Lkup_Job_Details').output.firstRow.sourcefile",
										"type": "Expression"
									},
									"col_delimiter": {
										"value": "@activity('Lkup_Job_Details').output.firstRow.delimiter",
